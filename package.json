{
  "name": "@adobe/aem-boilerplate",
  "private": true,
  "version": "1.3.0",
  "description": "Starter project for Adobe Helix",
  "scripts": {
    "demo:rates": "node test/dynamic-rates-server.mjs",
    "demo:xml-tools": "node test/xml-demo-server.mjs",
    "lint": "npm run lint:js && npm run lint:css && npm run lint:project",
    "lint:css": "stylelint \"blocks/**/*.css\" \"styles/**/*.css\" \"tools/**/*.css\" \"docs/**/*.css\" --max-warnings 0",
    "lint:fix": "npm run lint:js -- --fix && npm run lint:css -- --fix",
    "lint:js": "eslint . --ext .js,.mjs,.cjs --max-warnings 0 --report-unused-disable-directives",
    "test": "node --experimental-vm-modules --test test/*.test.js",
    "test:accordion": "node --experimental-vm-modules --test test/accordion-faq.test.js",
    "test:blocks": "node --experimental-vm-modules --test test/remaining-blocks.test.js",
    "test:cards": "node --experimental-vm-modules --test test/card-blocks.test.js test/remaining-blocks.test.js test/bank-rates.test.js test/card-rates.test.js",
    "test:demo-helper": "node --experimental-vm-modules --test test/demo-helper.test.js",
    "test:demo-session": "node --experimental-vm-modules --test test/demo-session.test.js",
    "test:disclosure-manager": "node --experimental-vm-modules --test test/disclosure-manager.test.js",
    "test:disclosures": "node --experimental-vm-modules --test test/disclosures.test.js",
    "test:hero": "node --experimental-vm-modules --test test/hero.test.js",
    "test:library": "node --experimental-vm-modules --test test/block-library.test.js",
    "test:link-options": "node --experimental-vm-modules --test test/link-options.test.js",
    "test:performance-demo": "node --experimental-vm-modules --test test/demo-performance.test.js test/demo-run-comparison.test.js test/demo-helper.test.js test/onetrust.test.js",
    "test:rates": "node --experimental-vm-modules --test test/bank-rates.test.js test/card-rates.test.js",
    "test:sections": "node --experimental-vm-modules --test test/section-authoring.test.js test/page-layout.test.js test/page-loading.test.js",
    "test:tracking": "node --experimental-vm-modules --test test/tracking.test.js",
    "test:xml-tools": "node --experimental-vm-modules --test test/xml-tools.test.js",
    "lint:project": "node tools/lint/project-checks.mjs",
    "lint:staged": "node tools/lint/project-checks.mjs --staged && lint-staged",
    "commitlint": "commitlint",
    "check:pr": "node tools/lint/pr-checks.mjs",
    "check": "npm run lint && npm test",
    "prepare": "husky"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/adobe/aem-boilerplate.git"
  },
  "author": "Adobe",
  "license": "Apache License 2.0",
  "bugs": {
    "url": "https://github.com/adobe/aem-boilerplate/issues"
  },
  "homepage": "https://github.com/adobe/aem-boilerplate#readme",
  "devDependencies": {
    "@babel/eslint-parser": "7.29.9",
    "@commitlint/cli": "21.2.4",
    "@commitlint/config-conventional": "21.2.4",
    "eslint": "8.57.1",
    "eslint-config-airbnb-base": "15.0.0",
    "eslint-plugin-import": "2.32.0",
    "husky": "9.1.7",
    "linkedom": "^0.18.13",
    "lint-staged": "17.6.0",
    "postcss-selector-parser": "7.1.7",
    "postcss-value-parser": "4.2.0",
    "prosemirror-model": "1.25.12",
    "prosemirror-state": "1.4.4",
    "stylelint": "17.15.0",
    "stylelint-config-standard": "40.0.0"
  },
  "engines": {
    "node": ">=24"
  }
}
